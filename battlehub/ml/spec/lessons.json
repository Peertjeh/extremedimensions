{
 "name": "battlehub-combat-lessons",
 "version": 1,
 "doc": "What a learned bot should practise in the simulation, from how its fights in the mod went. The mod (core/ml/Lessons, bot/ModelReports) counts per fight why the bot did not do what its model chose (reasons) and which observation values were new to the model (features, against combat_v*_ranges.json), weighs each lesson by the share of the fight it explains, tells the operators the biggest ones and writes them with their focus to config/battlehub/ml_feedback.json. train/focus.py reads that file and multiplies the scenario weights of ml/pvp_sim2 (Scenario) by the focus of each lesson: terrains, families and modes3 by key, three and chaos as numbers. A lesson with items needs the training with items (selfplay2.py --items). Every observation of every spec belongs to exactly one feature group (tests: ml/tests/test_lessons.py, LessonsTest).",
 "reasons": {
  "edge": "edges",
  "jump": "edges",
  "air": "air",
  "stuck": "obstacles",
  "recover": "edges",
  "evade": "projectiles",
  "heal": "eating",
  "shoot": "bow",
  "search": "cover",
  "objective": null,
  "react": null,
  "other": null
 },
 "features": [
  {"lesson": "distance", "names": ["opp_fwd", "opp_left", "opp_dist"]},
  {"lesson": "heights", "names": ["opp_up", "aim_pitch", "opp_vel_up", "self_vel_up", "self_fall", "self_below", "opp_below"]},
  {"lesson": "speed", "names": ["opp_vel_fwd", "opp_vel_left", "self_vel_fwd", "self_vel_left"]},
  {"lesson": "aim", "names": ["aim_yaw_sin", "aim_yaw_cos", "opp_look_sin", "opp_look_cos", "on_crosshair"]},
  {"lesson": "timing", "names": ["self_ground", "self_sprint", "self_charge", "self_hurt", "opp_visible", "opp_ground", "opp_sprint",
                                 "opp_since_swing", "opp_hurt", "damage_on"]},
  {"lesson": "hunger", "names": ["self_health", "opp_health", "self_food", "self_saturation", "self_regen"]},
  {"lesson": "kits", "names": ["self_absorption", "opp_absorption", "opp_blocking", "self_dmg", "opp_dmg", "self_cooldown", "opp_cooldown",
                               "self_kb", "opp_kb"]},
  {"lesson": "effects", "names": ["self_speed", "self_jump", "self_gravity", "self_scale", "opp_scale", "self_reach"]},
  {"lesson": "items", "prefixes": ["hand_"], "names": ["self_arrows", "self_food_items", "self_gapples", "self_pearls", "self_winds",
                                                      "self_shield", "pearl_cooldown", "wind_cooldown", "shield_cooldown", "self_use",
                                                      "self_blocking", "opp_eating", "opp_holds_food", "opp_holds_throwable"]},
  {"lesson": "projectiles", "prefixes": ["threat_"], "names": ["opp_draw", "opp_holds_bow"]},
  {"lesson": "crowds", "prefixes": ["e2_"], "names": ["enemies_near"]},
  {"lesson": "terrain", "prefixes": ["void_", "drop_", "edge_", "step_", "wall_"], "names": ["opp_drop_behind", "opp_void_behind"]}
 ],
 "lessons": {
  "edges": {"focus": {"terrains": {"bridge": 2.0, "platform": 2.0, "islands": 1.5}}},
  "air": {"focus": {"terrains": {"platform": 2.0, "bridge": 1.5}, "families": {"sumo": 1.5}}},
  "obstacles": {"focus": {"terrains": {"town": 2.0, "hills": 2.0}}},
  "projectiles": {"focus": {"families": {"bow": 2.0, "loot": 1.5}}},
  "eating": {"items": true, "focus": {"families": {"build_uhc": 1.5, "loot": 1.5}}},
  "bow": {"items": true, "focus": {"families": {"bow": 2.0}}},
  "cover": {"focus": {"terrains": {"town": 2.0}}},
  "distance": {"focus": {"families": {"bow": 1.5, "lms": 1.5, "ffa": 1.5}}},
  "heights": {"focus": {"terrains": {"hills": 2.0, "town": 1.5, "islands": 1.5}}},
  "speed": {"focus": {"families": {"mace": 1.5}, "chaos": 1.5}},
  "aim": {"focus": {}},
  "timing": {"focus": {}},
  "hunger": {"focus": {"families": {"build_uhc": 2.0}}},
  "kits": {"focus": {"chaos": 2.0, "families": {"loot": 1.5, "bedwars": 1.5}}},
  "effects": {"focus": {"chaos": 3.0}},
  "items": {"focus": {"families": {"loot": 1.5, "bedwars": 1.5}}},
  "crowds": {"focus": {"three": 2.0, "modes3": {"ffa": 1.5, "1v2": 1.5}}},
  "terrain": {"focus": {"terrains": {"town": 1.5, "hills": 1.5, "islands": 1.5, "bridge": 1.5}}}
 }
}
