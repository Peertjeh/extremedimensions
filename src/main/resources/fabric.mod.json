{
	"schemaVersion": 1,
	"id": "extremedimensions",
	"version": "${version}",
	"name": "Extreme Dimensions",
	"description": "Every portal is a wound. Charge anchors, bind your Tether and race the clock through the Nether and the End. Let the anchors run dry and the Starved take something of you: stacking penalties you have to play off. With lore, a journal, advancements and full multiplayer support.",
	"authors": [
		"Peertjeh"
	],
	"contact": {
		"sources": "https://github.com/Peertjeh/extremedimensions",
		"issues": "https://github.com/Peertjeh/extremedimensions/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/extremedimensions/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.extremedimensions.ExtremeDimensions"
		],
		"client": [
			"com.extremedimensions.client.ExtremeDimensionsClient"
		],
		"modmenu": [
			"com.extremedimensions.client.compat.ModMenuEntry"
		]
	},
	"mixins": [
		"extremedimensions.mixins.json",
		{
			"config": "extremedimensions.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.162.0"
	},
	"suggests": {
		"placeholder-api": "*"
	}
}
